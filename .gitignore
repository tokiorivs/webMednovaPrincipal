# ============================================================
# .gitignore para Next.js / React / TypeScript en Mednova
# ============================================================

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilación y producción de Next.js
/.next/
/out/
/build
/dist

# Variables de entorno y credenciales (Seguridad)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Mantener solo la plantilla pública de ejemplo
!.env.example

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Cache y TypeScript
*.tsbuildinfo
next-env.d.ts
.turbo

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cobertura de pruebas (Testing)
/coverage

# Despliegues temporales
.vercel
