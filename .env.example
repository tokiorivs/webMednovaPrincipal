# ---------------------------------------------------------------------------
# Supabase (https://supabase.com -> Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# SECRETA: solo en el servidor. Nunca la subas a git ni la pegues en el chat.
# Permite al panel escribir en la base de datos y gestionar usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL del sitio web (para sitemaps y canonicals)
NEXT_PUBLIC_SITE_URL=https://www.mednovaperu.com

# Datos de contacto de la empresa
NEXT_PUBLIC_COMPANY_WHATSAPP=51987654321
NEXT_PUBLIC_COMPANY_EMAIL=contacto@mednova.com
