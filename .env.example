# ---------------------------------------------------------------------------
# Supabase (https://supabase.com -> Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# SECRETA: solo en el servidor. Nunca la subas a git ni la pegues en el chat.
# Permite al panel escribir en la base de datos y gestionar usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# URL del sitio web (para sitemaps y canonicals)
NEXT_PUBLIC_SITE_URL=https://www.mednovaperu.com

# Datos de contacto de la empresa
NEXT_PUBLIC_COMPANY_WHATSAPP=51987654321
NEXT_PUBLIC_COMPANY_EMAIL=contacto@mednova.com

# Código de verificación de Google Search Console (meta tag "google-site-verification"). Opcional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Generación de fichas con IA (Claude). SECRETA: solo en el servidor, nunca en el chat ni en git.
# Crea la clave en https://console.anthropic.com -> API keys. Sin ella el botón "Generar con IA" avisa que falta.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5).
ANTHROPIC_MODEL=

# Gemini (Google) - proveedor de IA predeterminado. SECRETA: solo en el servidor.
# Crea la clave en https://aistudio.google.com/apikey. Sin ella el panel avisa que falta.
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.8-flash).
GEMINI_MODEL=

# Subida de imágenes a Cloudflare R2 desde el panel. SECRETAS: solo en el servidor, nunca en el chat ni en git.
# Cloudflare -> R2 -> panel del bucket: Account ID. Token en R2 -> Manage R2 API Tokens, con permiso
# "Object Read & Write" limitado SOLO a este bucket. El dominio público se configura en Ajustes -> Medios.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
